{
  "name": "routealarm-proxy",
  "version": "1.0.0",
  "private": true,
  "description": "RouteAlarm 앱용 Backend Proxy. ODsay(대중교통 경로)와 Kakao 로컬(장소 검색) 응답을 앱 계약 형식으로 정규화한다.",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  }
}
