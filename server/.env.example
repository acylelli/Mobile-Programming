# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 git 에 올라가지 않는다.
# 실제 키는 저장소가 아니라 팀 공유 금고나 배포 서비스의 환경변수로 전달한다.

# ODsay LAB > 애플리케이션 관리에서 발급한 키 (서버용 키는 호출하는 서버 IP 를 등록해야 한다)
# 로컬 개발에는 배포 서버와 다른 개발용 키를 쓰거나, ODSAY_MOCK=1 로 가짜 응답을 쓴다(하루 1,000번 한도를 나눠 쓰지 않도록).
ODSAY_API_KEY=
# ODSAY_MOCK=1

# Kakao Developers > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=

PORT=8080

# 실시간 도착 정보 (선택). 비워 두면 출발이 가까워도 시간표 기준으로만 응답한다.
# 서울 열린데이터광장 > 인증키 신청 > 실시간 지하철 인증키
SEOUL_SUBWAY_API_KEY=
# 공공데이터포털 일반 인증키(Decoding). 서울특별시_버스도착정보조회, 경기도_버스도착정보 조회 활용신청 필요
DATA_GO_KR_SERVICE_KEY=

# 남용 방지 한도 (비워 두면 기본값). server/README.md "남용 방지" 참고
# ROUTES_PER_MINUTE=20
# ODSAY_PER_IP_DAILY_LIMIT=150
# SEARCH_PER_MINUTE=60
# ODSAY_DAILY_LIMIT=1000
# KAKAO_DAILY_LIMIT=10000
# REALTIME_DAILY_LIMIT=900

# 토스페이먼츠 API 개별 연동 키(테스트). developers.tosspayments.com > API 키
# 비워 두면 결제 경로(/pay/*, /v1/payments)가 503 을 준다. 시크릿 키는 앱에 넣지 않는다.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 단체 이용권 코드(선택, JSON 배열). 비워 두면 테스트 코드(HSU-2026-WAKE7 등)를 쓴다.
# GROUP_PASSES=[{"code":"HSU-2026-WAKE7","organization":"한성대학교","valid_from":"2026-03-01","valid_until":"2027-02-28","remaining_seats":128}]
